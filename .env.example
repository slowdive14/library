# Telegram Bot Settings
# Create bot with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get Chat ID: Send message to your bot, then visit
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# Google Service Account Credentials (entire JSON content in one line)
# Create at: Google Cloud Console -> IAM & Admin -> Service Accounts
GOOGLE_SHEET_CREDENTIALS={"type":"service_account","project_id":"..."}

# Google Sheet URL
# Share the sheet with the service account's client_email
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_sheet_id/edit

# Optional: minutes between availability checks (default 5)
# MONITOR_INTERVAL_MINUTES=5

# Optional: hours between new-arrival checks for /new (default 6)
# NEW_ARRIVAL_HOURS=6

# Optional: hours (KST, start-end) with no checks or alerts (default 22-8); empty turns it off
# QUIET_HOURS=22-8

# Optional: set to true to use webhook mode on Render instead of polling.
# The monitor then only runs while Render keeps the instance awake.
# USE_WEBHOOK=true
